{
  "name": "superezio-desktop",
  "version": "4.2.0",
  "description": "SuperEzio â€” Trade e assistente de investimento",
  "author": "SuperEzio",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.superezio.desktop",
    "productName": "SuperEzio",
    "asar": true,
    "directories": {
      "output": "../dist/windows"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "settings.cjs",
      "autoprovision.cjs",
      "setup.html",
      "setup.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/desktop-backend/SuperEzioBackend",
        "to": "backend",
        "filter": ["**/*", "!runtime/**", "!data/**", "!journal/**", "!**/*.db", "!**/*.db-*", "!**/*.log", "!**/.env*"]
      }
    ],
    "win": {
      "icon": "../superezio.ico",
      "target": "nsis",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "SuperEzio-Setup-${version}-${arch}.${ext}"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  }
}
