# =============================================================================
# SuperEzio v4.0.0 — Environment Configuration
# Generated: 2026-07-20 — Dev Mode Audit
#
# HOW DEV MODE WORKS:
#   If SUPEREZIO_JWT_SECRET is EMPTY  → JWT auth disabled (anonymous dev_anon user)
#   If SUPEREZIO_API_KEY is EMPTY     → API key auth disabled
#   If both are empty                 → full dev mode, system runs with no auth
#   Frontend detects dev mode via GET /cockpit/summary returning 200 without token
#
# MARKET DATA FALLBACK CHAIN:
#   Twelve Data (key req) → Alpha Vantage (key req) → yfinance (no key needed)
#   yfinance is the last resort — works without any API key
#
# SAFETY DEFAULTS (locked):
#   F51_TRADING_EXECUTION_FREEZE=true      → ALL orders blocked by default
#   SUPEREZIO_ENABLE_PAPER_ORDER_SUBMIT=0  → Paper submit disabled by default
#   SUPEREZIO_LIVE_TRADING_DISABLED=1      → Live trading disabled by default
#   SUPEREZIO_DAYTRADE_PAPER_ONLY=1        → Daytrade paper-only by default
# =============================================================================

# ═════════════════════════════════════════════════════════════════════════════
# DEV MODE — Boot Greeting
# ═════════════════════════════════════════════════════════════════════════════
# Empty JWT secret = dev mode. Set a real 256-bit key for production.
SUPEREZIO_JWT_SECRET=
# SUPEREZIO_JWT_ALGORITHM=HS256
# SUPEREZIO_JWT_ACCESS_TTL=3600
# SUPEREZIO_JWT_REFRESH_TTL=2592000

# Open guest access for a small trusted distribution (no login wall).
# Keep PUBLIC_MODE=1 + JWT secret so the server still boots fail-closed;
# OPEN_ACCESS=1 injects guest_open instead of requiring Sign In.
# Registration stays closed. Paper trade and local TD drafts skip the extra
# identification factor. Live broker transmission stays frozen independently.
# SUPEREZIO_OPEN_ACCESS=0
# SUPEREZIO_PUBLIC_MODE=0
# SUPEREZIO_PUBLIC_REGISTRATION=0

# API key-based auth (alternative to JWT). Empty = dev mode.
# SUPEREZIO_API_KEY=

# ═════════════════════════════════════════════════════════════════════════════
# CRITICAL — Security & Execution (safe defaults locked)
# ═════════════════════════════════════════════════════════════════════════════
# Global kill switch. TRUE = ALL orders BLOCKED.
# NEVER set to false in production without explicit approval.
F51_TRADING_EXECUTION_FREEZE=true

# Enable paper order submission to IBKR TWS. Requires explicit opt-in.
SUPEREZIO_ENABLE_PAPER_ORDER_SUBMIT=0

# C1 architecture cut: write EvidencePack in shadow next to each run.
# Does not change Bob, routing, or gates. Set 0 to roll back the file write.
SUPEREZIO_ARCH_C1=1

# C2 architecture cut: freeze Snapshot (snapshot.json + state.snapshot).
# Does not bind Bob's prompt. Set 0 to roll back freeze and file write.
SUPEREZIO_ARCH_C2=1

# C3 architecture cut: Bob reads SNAPSHOT FROZEN and answers bind to snapshot.numbers.
# Default 1. Set 0 to roll back to C2 (shadow freeze + CENSORSHIP_SKIPPED).
SUPEREZIO_ARCH_C3=1

# Block live (real-money) trading. 1 = disabled (safe default).
SUPEREZIO_LIVE_TRADING_DISABLED=1

# Research mode: only paper transactions, no live execution.
SUPEREZIO_RESEARCH_PAPER_ONLY=1

# Daytrade mode: paper-only by default.
SUPEREZIO_DAYTRADE_PAPER_ONLY=1

# Bob sovereign mode — allows unrestricted ticket references.
# SUPEREZIO_BOB_SOVEREIGN=0

# ═════════════════════════════════════════════════════════════════════════════
# MODEL RUNTIME — DeepSeek V4 Flash for every role. GLM-5.3 is optional.
# ═════════════════════════════════════════════════════════════════════════════
# Default: Bob/CEO, orchestrator, experts, judge and auditor on official DeepSeek.
# Leave these commented to use the code default (deepseek-v4-flash).
# If PRIMARY/AGENT is set to glm-5.3 WITHOUT SUPEREZIO_GLM_CODING_PLAN_API_KEY,
# the process still boots and those roles fall back to DeepSeek.
# SUPEREZIO_PRIMARY_MODEL=deepseek-v4-flash
# SUPEREZIO_AGENT_MODEL=deepseek-v4-flash
# SUPEREZIO_AGENT_TIMEOUT_SEC=180
# Optional Z.ai path (only built when the coding-plan key is present):
# SUPEREZIO_PRIMARY_BASE_URL=https://api.z.ai/api/coding/paas/v4
# SUPEREZIO_AGENT_BASE_URL=https://api.z.ai/api/coding/paas/v4
# SUPEREZIO_GLM_CODING_PLAN_API_KEY=

# Daytrade judge and auditor use only the official HTTPS DeepSeek endpoint.
SUPEREZIO_DEEPSEEK_BASE_URL=https://api.deepseek.com
SUPEREZIO_DEEPSEEK_MODEL=deepseek-v4-flash
# SUPEREZIO_DEEPSEEK_API_KEY=
# SUPEREZIO_DEEPSEEK_MAX_TOKENS=1800
# SUPEREZIO_DEEPSEEK_TIMEOUT_SEC=180
# SUPEREZIO_DEEPSEEK_TEMPERATURE=0.2
# Custom compatible HTTPS hosts are rejected unless this explicit contract is
# enabled. HTTP, credentials in URLs, private hosts and non-443 ports remain forbidden.
# SUPEREZIO_ALLOW_CUSTOM_DEEPSEEK_BASE_URL=0

# Docker Compose sets this internally. Do not set it on the Windows host:
# SUPEREZIO_RUNTIME_PROFILE=docker

# Obsolete cloud-only aliases retained here only as a migration warning:
# SUPEREZIO_PRIMARY_API_KEY=
# SUPEREZIO_AGENT_API_KEY=
# GEMINI_API_KEY=
# SUPEREZIO_GLM_CODE_PLAN_API_KEY=
# SUPEREZIO_AGENT_CLOUD_API_KEY=
# SUPEREZIO_AGENT_CLOUD_URL=

# ═════════════════════════════════════════════════════════════════════════════
# MARKET DATA PROVIDERS — Without API keys, yfinance is used as fallback
# ═════════════════════════════════════════════════════════════════════════════

# ── Twelve Data (primary price/candles source) ──
# TWELVE_DATA_API_KEY=

# ── Finnhub (quotes, fundamentals, news) ──
# FINNHUB_API_KEY=
# FINNHUB_MIN_INTERVAL_SEC=1.05
# FINNHUB_METRIC_CACHE_TTL_SEC=60

# ── Alpha Vantage (price, treasury yields, BDR coverage) ──
# ALPHA_VANTAGE_API_KEY=

# ── Wolfram Alpha (quantitative/math verification) ──
# WOLFRAM_API_KEY=

# ── NewsAPI (traditional news sentiment) ──
# NEWSAPI_KEY=

# ── Form4API (SEC insider trades, free tier available) ──
# FORM4API_KEY=

# ── Tavily (web search/extract) ──
# TAVILY_API_KEY=

# ── Brave Search ──
# BRAVE_SEARCH_API_KEY=

# ── Alpaca (broker alternative) ──
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=

