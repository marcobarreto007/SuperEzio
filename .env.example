# IBKR_PORT=7497
# IBKR_CLIENT_ID=1
# IBKR_SERVICE_CLIENT_ID=100
# IBKR_CACHE_TTL_SEC=10
# IBKR_COOLDOWN_SEC=60
# IBKR_COOLDOWN_MAX_ERRORS=3
# IBKR_REFRESH_INTERVAL_SEC=15
# IBKR_ACCOUNT_ID=

# Enable read of IBKR orders in cockpit (1 = enabled, 0 = disabled)
# SUPEREZIO_COCKPIT_READ_IBKR_ORDERS=1

