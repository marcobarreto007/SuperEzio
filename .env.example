# ===========================================================================
# SuperEzio — F51 Unified Core Environment Variables Example
# ===========================================================================
# Este arquivo serve de modelo para a inicializacao de ambientes de producao local.
# Copie este arquivo para '.env' e preencha as chaves necessarias.

# ---------------------------------------------------------------------------
# 1. PIPELINE RUNTIME CONFIGURATIONS
# ---------------------------------------------------------------------------
SUPEREZIO_ORCHESTRATOR_TIMEOUT=12
SUPEREZIO_CEO_TIMEOUT=120
SUPEREZIO_DATA_TIMEOUT=60
SUPEREZIO_EXPERT_TIMEOUT=60
SUPEREZIO_EXPERT_CONCURRENCY=4
SUPEREZIO_INTENT_LLM_FALLBACK=auto
SUPEREZIO_INTENT_LLM_THRESHOLD=0.76
SUPEREZIO_INTENT_LLM_TIMEOUT=4
SUPEREZIO_SCAN_LIMIT=30
SUPEREZIO_FORCE_ALL_EXPERTS_ON_PARTIAL=1
SUPEREZIO_PROFESSIONAL_COLLECTOR=true
SUPEREZIO_CEO_TEMPERATURE=0.3
SUPEREZIO_CEO_MAX_TOKENS=4096

# Para testes locais e integracao, pule a validacao do EdgeGateway inicial
UNIVERSAL_SKIP_GATEWAY=1

# ---------------------------------------------------------------------------
# 2. MODEL SERVING & PROVIDERS (IA LLM)
# ---------------------------------------------------------------------------
# Chave primaria F51 (utilizada pelo balanceador e gateway central)
SUPEREZIO_PRIMARY_API_KEY=

# Servico DeepSeek
SUPEREZIO_DEEPSEEK_API_KEY=
SUPEREZIO_DEEPSEEK_MODEL=deepseek-chat
SUPEREZIO_DEEPSEEK_BASE_URL=https://api.deepseek.com
SUPEREZIO_DEEPSEEK_TIMEOUT_SEC=120
SUPEREZIO_DEEPSEEK_TEMPERATURE=0.2
SUPEREZIO_DEEPSEEK_REASONING_EFFORT=high
SUPEREZIO_DEEPSEEK_THINKING=disabled

# ---------------------------------------------------------------------------
# 3. DATA PROVIDERS & SCRAPERS (MERCADO FINANCEIRO)
# ---------------------------------------------------------------------------
WOLFRAM_API_KEY=
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
BRAVE_SEARCH_API_KEY=
NEWSAPI_KEY=

SUPEREZIO_REDDIT_ENABLED=1
SUPEREZIO_REDDIT_SUBREDDITS=stocks,wallstreetbets,pennystocks
SUPEREZIO_TAVILY_SEARCH_PATH=
SUPEREZIO_TAVILY_EXTRACT_PATH=

# ---------------------------------------------------------------------------
# 4. INFRASTRUCTURE & NETWORK
# ---------------------------------------------------------------------------
A2A_PORT=8002
A2A_BIND=127.0.0.1
A2A_AGENT_NAME=generic_agent

# Memoria Persistente (mem0)
MEM0_API_URL=
MEM0_API_KEY=
MEM0_REDIS_URL=

CORS_ORIGINS=*
SUPEREZIO_HOST=127.0.0.1
SUPEREZIO_PORT=8002

# ---------------------------------------------------------------------------
# 5. OBSERVABILITY, CACHING & RAG (RECUPERACAO DE CONTEXTO)
# ---------------------------------------------------------------------------
SUPEREZIO_DEBUG=
DISABLE_OTEL=1

SUPEREZIO_RAG_MODEL=all-MiniLM-L6-v2
SUPEREZIO_RAG_TOP_K=5
SUPEREZIO_RAG_CONTEXT_MAX_CHARS=2500
SUPEREZIO_RAG_DISABLED=0

SUPEREZIO_CACHE_DIR=
SUPEREZIO_DATA_DIR=data

# ---------------------------------------------------------------------------
# 6. PENNYLAB EXPERT DECISION RULES
# ---------------------------------------------------------------------------
PENNYLAB_JOURNAL=
PENNYLAB_MAX_USD=50.0
PENNYLAB_MAX_PRICE=5.0
PENNYLAB_MIN_VOLUME=500000

# ---------------------------------------------------------------------------
# 7. MISCELLANEOUS (LORA & SCRIPTS DE TOMADA DE DECISAO)
# ---------------------------------------------------------------------------
SUPEREZIO_ENABLE_PYTHON_EXEC=
EXPLANATION_MODEL_PATH=
EXPLANATION_LORA_PATH=
