# ===========================================================================
# SuperEzio — F51 Unified Core Environment Variables Example
# ===========================================================================
# Copie este arquivo para '.env' e preencha as chaves necessarias.

# ---------------------------------------------------------------------------
# 1. PIPELINE RUNTIME CONFIGURATIONS
# ---------------------------------------------------------------------------
SUPEREZIO_DATA_TIMEOUT=60
SUPEREZIO_EXPERT_TIMEOUT=60
SUPEREZIO_INTENT_LLM_FALLBACK=auto
SUPEREZIO_INTENT_LLM_THRESHOLD=0.76
SUPEREZIO_INTENT_LLM_TIMEOUT=4

# Confidence thresholds
SUPEREZIO_BUY_CONFIDENCE_THRESHOLD=0.80
SUPEREZIO_STRONG_CONFIDENCE_THRESHOLD=0.90
SUPEREZIO_MAX_CONFIDENCE_GATE_FAILURE=0

# Scanner: 12 tickers per country, capped at 24 total (US+CA).
SUPEREZIO_SCAN_LIMIT=12
SUPEREZIO_SCAN_MAX_TOTAL=24
SUPEREZIO_SCAN_MAX_CANDIDATES_RAW=48
SUPEREZIO_SCAN_MAX_CANDIDATES_AFTER_GATE=24
SUPEREZIO_SCAN_MAX_LLM_CALLS=6
SUPEREZIO_SCAN_MAX_LLM_CANDIDATES=12
SUPEREZIO_SCAN_LLM_TIMEOUT_SECONDS=300
SUPEREZIO_SCAN_STAGE_DEADLINE_MS=60000
# Finnhub calls: price on up to 24 rows; profile+catalyst on first 12 only.
SUPEREZIO_SCAN_ENRICH=12
SUPEREZIO_SCAN_PRICE_ENRICH=24
SUPEREZIO_SCAN_ENRICH_TIMEOUT_MS=45000
# Parallel hub calls during scan (Finnhub free tier 60/min — keep at 2).
SUPEREZIO_SCAN_ENRICH_CONCURRENCY=2
# Seconds between Finnhub HTTP calls (free tier 60/min).
FINNHUB_MIN_INTERVAL_SEC=1.05

# Volume filters
SUPEREZIO_MIN_AVG_DAILY_VOLUME_SHARES=100000
SUPEREZIO_MIN_AVG_DAILY_DOLLAR_VOLUME_USD=500000

SUPEREZIO_PROFESSIONAL_COLLECTOR=true
A2A_AGENT_NAME=superezio

# ---------------------------------------------------------------------------
# 2. MODEL SERVING & PROVIDERS (IA LLM)
# ---------------------------------------------------------------------------
SUPEREZIO_PRIMARY_API_KEY=

# Servico DeepSeek
SUPEREZIO_DEEPSEEK_API_KEY=
SUPEREZIO_DEEPSEEK_MODEL=deepseek-chat
SUPEREZIO_DEEPSEEK_BASE_URL=https://api.deepseek.com
SUPEREZIO_DEEPSEEK_TIMEOUT_SEC=120
SUPEREZIO_DEEPSEEK_MAX_TOKENS=4096
SUPEREZIO_DEEPSEEK_TEMPERATURE=0.2
SUPEREZIO_DEEPSEEK_REASONING_EFFORT=high
SUPEREZIO_DEEPSEEK_THINKING=disabled

# Gemini 3.1 Pro — sentiment & narrative expert (Google AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_TIMEOUT_SEC=90
GEMINI_MAX_TOKENS=1024
GEMINI_TEMPERATURE=0.3

# ---------------------------------------------------------------------------
# 3. DATA PROVIDERS & SCRAPERS (MERCADO FINANCEIRO)
# ---------------------------------------------------------------------------
WOLFRAM_API_KEY=
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
BRAVE_SEARCH_API_KEY=
NEWSAPI_KEY=
# Primary market data (DataHub tries: finnhub → twelve_data → yfinance → stooq)
FINNHUB_API_KEY=

SUPEREZIO_REDDIT_ENABLED=1
SUPEREZIO_REDDIT_SUBREDDITS=stocks,wallstreetbets,pennystocks
SUPEREZIO_TAVILY_SEARCH_PATH=
SUPEREZIO_TAVILY_EXTRACT_PATH=

# ---------------------------------------------------------------------------
# 4. INFRASTRUCTURE & NETWORK
# ---------------------------------------------------------------------------
SUPEREZIO_HOST=127.0.0.1
SUPEREZIO_PORT=8002
CORS_ORIGINS=*

# Memoria Persistente (mem0)
MEM0_API_URL=
MEM0_API_KEY=
MEM0_REDIS_URL=

# Eval / smoke test URLs
SUPEREZIO_EVAL_URL=http://127.0.0.1:8002
SUPEREZIO_BROWSER_SMOKE_URL=http://127.0.0.1:8002
GLM_EVAL_MODEL=glm-4-flash
GLM_EVAL_URL=https://open.bigmodel.cn/api/paas/v4

# ---------------------------------------------------------------------------
# 5. OBSERVABILITY, CACHING & RAG
# ---------------------------------------------------------------------------
SUPEREZIO_DEBUG=
DISABLE_OTEL=1
SUPEREZIO_OTEL_CONSOLE=

SUPEREZIO_RAG_MODEL=all-MiniLM-L6-v2
SUPEREZIO_RAG_TOP_K=5
SUPEREZIO_RAG_CONTEXT_MAX_CHARS=2500
SUPEREZIO_RAG_DISABLED=0
SUPEREZIO_RAG_INDEX_DIR=data/faiss_index

SUPEREZIO_CACHE_DIR=
SUPEREZIO_DATA_DIR=data

# ---------------------------------------------------------------------------
# 6. OPTIONAL — BROKER & ALERTING (default off, no live trading)
# ---------------------------------------------------------------------------
# Alpaca paper trading (only used if trading layer is enabled by integrator)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Interactive Brokers TWS / IB Gateway (only if IBKR adapter is wired)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# SMTP alerting (leave blank to disable email alerts)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# ---------------------------------------------------------------------------
# 7. MISCELLANEOUS
# ---------------------------------------------------------------------------
SUPEREZIO_ENABLE_PYTHON_EXEC=
