['import json,os,sys,time', 'from pathlib import Path', 'from playwright.sync_api import sync_playwright, TimeoutError as PWTimeout', '', 'ROOT = Path("C:/Users/marco/Desktop/SuperEzio")', 'BASE_URL = "http://127.0.0.1:8002"', 'OUT_DIR = ROOT / "output" / "playwright"', 'OUT_DIR.mkdir(parents=True, exist_ok=True)', 'STAMP = time.strftime("%Y%m%d-%H%M%S")', 'results = {"tasks": {}, "screenshots": [], "console_errors": [], "page_errors": []}', 'CE = []', '', 'def sp(page, name):', '    path = OUT_DIR / f"etapa2_{name}_{STAMP}.png"', '    page.screenshot(path=str(path), full_page=True)', '    results["screenshots"].append(str(path))', '    print(f"  ss: {path.name}")', '    return str(path)', '', 'def t(name, ok, detail="", evidence=None):', '    results["tasks"][name] = {"ok": ok, "detail": detail, "evidence": evidence}', '    s = "PASS" if ok else "FAIL"', '    print(f"  [{s}] {name}: {detail}")']