diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -2529,10 +2529,86 @@ static bool f51_cuda_moe_cache_enabled() {
 
     const bool f51_cache_enabled = f51_cuda_moe_cache_enabled();
 
-    static int f51_cache_capacity = -1;
-    if (f51_cache_capacity < 0) {
-        const char * env = getenv("F51_MOE_CACHE_CAPACITY");
-        f51_cache_capacity = env ? std::max(1, atoi(env)) : 256;
+    // ── F51 Architecture-Aware Cache Capacity ──────────────────────
+    //
+    // The F51 cache operates at ggml level (mul_mat_id), where all MoE
+    // experts appear as src0 with ne[2]=n_expert, nb[2]=expert_bytes.
+    // We auto-detect the model profile from the first expert tensor and
+    // select an appropriate cache capacity.
+    //
+    // Models and their expert structure:
+    //   Mixtral 8x7B:    8 experts,  2 used/token → cache 4-8
+    //   GPT-OSS 120B:  128 experts,  4 used/token → cache 8-16
+    //   DeepSeek V2:   160 experts,  6 used/token → cache 12
+    //   Qwen2MoE:       60 experts,  8 used/token → cache 16
+    //
+    // Env var F51_MOE_CACHE_CAPACITY overrides auto-detection.
+    // Env var F51_MOE_CACHE_CAPACITY=0 enables auto-detection (default).
+
+    struct f51_model_profile_t {
+        int64_t n_expert;
+        size_t  expert_bytes;
+        int     auto_capacity;
+        bool    detected;
+        char    tensor_prefix[64];
+
+        f51_model_profile_t() : n_expert(0), expert_bytes(0),
+                                 auto_capacity(0), detected(false) {
+            memset(tensor_prefix, 0, sizeof(tensor_prefix));
+        }
+    };
+    static f51_model_profile_t f51_profile;
+
+    // Read env override once
+    static int f51_env_capacity = -2;  // -2 = not yet read
+    if (f51_env_capacity == -2) {
+        const char * env = getenv("F51_MOE_CACHE_CAPACITY");
+        f51_env_capacity = env ? std::max(1, atoi(env)) : 0;
+    }
+
+    // Resolve effective capacity: env > auto > fallback(256)
+    int f51_cache_capacity;
+    if (f51_env_capacity > 0) {
+        f51_cache_capacity = f51_env_capacity;
+    } else if (f51_profile.detected) {
+        f51_cache_capacity = f51_profile.auto_capacity;
+    } else {
+        f51_cache_capacity = 256;  // fallback until detected
     }
+
     static int f51_log_count = 0;
     static int f51_debug_enabled = -1;
     if (f51_debug_enabled < 0) {
@@ -2606,6 +2682,63 @@ static void ggml_cuda_mul_mat_id(ggml_backend_cuda_context & ctx, ggml_tensor *
     if (f51_cache_enabled && src0->buffer && src0->data && ids->data) {
+        // ── F51 Architecture Detection (first expert tensor) ──────
+        if (!f51_profile.detected && src0->name && src0->ne[2] > 0 && src0->nb[2] > 0) {
+            f51_profile.n_expert     = src0->ne[2];
+            f51_profile.expert_bytes = (size_t) src0->nb[2];
+
+            // Identify tensor prefix from name
+            const char * name = src0->name;
+            if (strstr(name, "ffn_gate_up_exps")) {
+                strncpy(f51_profile.tensor_prefix, "ffn_gate_up_exps", sizeof(f51_profile.tensor_prefix) - 1);
+            } else if (strstr(name, "ffn_gate_exps")) {
+                strncpy(f51_profile.tensor_prefix, "ffn_gate_exps", sizeof(f51_profile.tensor_prefix) - 1);
+            } else if (strstr(name, "ffn_up_exps")) {
+                strncpy(f51_profile.tensor_prefix, "ffn_up_exps", sizeof(f51_profile.tensor_prefix) - 1);
+            } else if (strstr(name, "ffn_down_exps")) {
+                strncpy(f51_profile.tensor_prefix, "ffn_down_exps", sizeof(f51_profile.tensor_prefix) - 1);
+            } else {
+                strncpy(f51_profile.tensor_prefix, "unknown", sizeof(f51_profile.tensor_prefix) - 1);
+            }
+
+            // Infer n_expert_used from ids->ne[0] (top-K per token)
+            const int64_t f51_n_expert_used = ids->ne[0];
+
+            // Auto-select capacity based on expert count and usage pattern
+            // With ~65% expert persistence, we need at least 2× n_expert_used
+            if (f51_profile.n_expert <= 8) {
+                // Mixtral 8x7B: 8 experts, 2 used → cache all (small enough)
+                f51_profile.auto_capacity = (int) f51_profile.n_expert;
+            } else if (f51_profile.n_expert <= 16) {
+                // PhiMoE/DBRX: ~16 experts → cache 12
+                f51_profile.auto_capacity = 12;
+            } else if (f51_profile.n_expert <= 64) {
+                // Qwen-style: ~60 experts → cache 16
+                f51_profile.auto_capacity = 16;
+            } else {
+                // GPT-OSS/DeepSeek: 128-256 experts → cache 16
+                // 65% persistence means ~4-6 unique experts per decode
+                // 16 slots gives 4× headroom for rare expert swaps
+                f51_profile.auto_capacity = 16;
+            }
+
+            f51_profile.detected = true;
+
+            // Recalculate effective capacity now that we detected
+            if (f51_env_capacity <= 0) {
+                f51_cache_capacity = f51_profile.auto_capacity;
+            }
+
+            fprintf(stderr,
+                "F51 ARCH: profile detected → n_expert=%lld n_expert_used=%lld "
+                "expert_bytes=%zu prefix='%s' auto_capacity=%d effective_capacity=%d "
+                "tensor='%s'\n",
+                (long long) f51_profile.n_expert,
+                (long long) f51_n_expert_used,
+                f51_profile.expert_bytes,
+                f51_profile.tensor_prefix,
+                f51_profile.auto_capacity,
+                f51_cache_capacity,
+                src0->name ? src0->name : "?");
+            fflush(stderr);
+        }
+
         bool f51_experts_on_cpu = true;
         cudaPointerAttributes f51_attrs = {};
         const cudaError_t f51_attr_err = cudaPointerGetAttributes(&f51_attrs, src0->data);
