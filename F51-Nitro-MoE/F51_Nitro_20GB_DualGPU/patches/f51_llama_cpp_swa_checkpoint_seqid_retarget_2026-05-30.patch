+// F51 fix: checkpoint seq_id retargeting
+// When a prompt cache entry is restored to a different slot,
+// the checkpoints still reference the old slot's seq_id.
+// The main state gets remapped by llama_state_seq_set_data_ext(),
+// but checkpoints saved with LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY
+// have the seq_id burned into their header at offset sizeof(uint32_t).
+// Without this rebase, llama-context.cpp:2663 throws "wrong sequence id".
+static bool retarget_checkpoint_seq_id(server_prompt_checkpoint & ckpt, llama_seq_id dst) {
+    constexpr size_t off = sizeof(uint32_t); // skip io_magic
+    if (ckpt.data.size() < off + sizeof(llama_seq_id)) {
+        return false;
+    }
+    std::memcpy(ckpt.data.data() + off, &dst, sizeof(dst));
+    return true;
+}
